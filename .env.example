# Copy to .env and fill in. `.env` is gitignored and must never be committed.
#   cp .env.example .env
#
# Every value below has a working default for local development EXCEPT the two
# marked REQUIRED-FOR, which gate optional paths. The core demo runs with none
# of them set.

# ---- infrastructure (defaults match docker-compose.yml) ------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=salvage
POSTGRES_USER=salvage
POSTGRES_PASSWORD=salvage_local_dev_only

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ---- service ports -------------------------------------------------------
# Ports published on the HOST. The containers always listen on 8080 and 8000
# internally; these only affect what you can reach from your machine. Change
# them if something else already holds the port -- that is why the defaults
# are not 8080 and 8000, which are the two most contended ports there are.
CORE_HOST_PORT=8081
BRAIN_HOST_PORT=8001

# ---- payment provider ----------------------------------------------------
# simulated | razorpay
# `simulated` is the default and requires no credentials. It is deterministic
# and seeded, and it is what `make demo` and CI use.
# `razorpay` issues real calls against Razorpay TEST mode and requires the keys
# below. See docs/adr/0003-payment-provider-abstraction.md.
SALVAGE_PAYMENT_PROVIDER=simulated
SALVAGE_SIMULATED_PROVIDER_SEED=20260829

# NOT YET USED. The PaymentProvider port and the Razorpay adapter are Phase 4
# deliverables (docs/adr/0003-payment-provider-abstraction.md). These keys are
# listed now so the shape of the configuration is visible, but nothing reads
# them yet, and `make razorpay-e2e` exits non-zero saying so.
#
# When Phase 4 lands: Razorpay Dashboard -> Settings -> API Keys, in TEST
# mode. Test keys are prefixed rzp_test_, and a startup guard rejecting
# rzp_live_ keys is part of that phase's work.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Settings -> Webhooks. HMAC signature verification of
# inbound webhooks. Also Phase 4.
RAZORPAY_WEBHOOK_SECRET=

# REQUIRED-FOR: the Phase 6 language layer (narration, customer messaging,
# audit Q&A, unknown-error-code triage). No money decision depends on it.
ANTHROPIC_API_KEY=
