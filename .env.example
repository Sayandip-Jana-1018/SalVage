# Copy to .env and fill in. `.env` is gitignored and must never be committed.
#   cp .env.example .env
#
# Every value below has a working default for local development EXCEPT the two
# marked REQUIRED-FOR, which gate optional paths. The core demo runs with none
# of them set.

# ---- infrastructure (defaults match docker-compose.yml) ------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=salvage
POSTGRES_USER=salvage
POSTGRES_PASSWORD=salvage_local_dev_only

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ---- service ports -------------------------------------------------------
# Ports published on the HOST. The containers always listen on 8080 and 8000
# internally; these only affect what you can reach from your machine. Change
# them if something else already holds the port -- that is why the defaults
# are not 8080 and 8000, which are the two most contended ports there are.
CORE_HOST_PORT=8081
BRAIN_HOST_PORT=8001

# ---- payment provider ----------------------------------------------------
# simulated | razorpay
# `simulated` is the default and requires no credentials. It is deterministic,
# seeded, and runs all test suites, CI, stress tests, and offline simulations.
# `razorpay` issues real test-mode calls against Razorpay Sandbox/Test APIs.
# See docs/adr/0003-payment-provider-abstraction.md.
SALVAGE_PAYMENT_PROVIDER=simulated
SALVAGE_SIMULATED_PROVIDER_SEED=20260829

# OPTIONAL: Razorpay Test Mode Credentials
# For Razorpay Hackathon / Live Test Mode evaluation:
# Obtain keys from: Razorpay Dashboard -> Settings -> API Keys (TEST Mode).
# Test keys must be prefixed with `rzp_test_`. salvage-core refuses to start if this
# value begins with `rzp_live_` (ProviderCredentialsGuard). Note that no
# Setting these alone changes nothing: the backend talks to Razorpay only when
# SALVAGE_PAYMENT_PROVIDER=razorpay is also set. Test-mode keys only --
# salvage-core refuses to start on a key beginning rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Settings -> Webhooks. Used for HMAC-SHA256 signature verification.
RAZORPAY_WEBHOOK_SECRET=

# ---- language layer (Phase 11) -------------------------------------------
# This block was empty until Phase 11, and the reason it was empty is worth
# keeping: it once declared GEMINI_API_KEY, GROK_API_KEY and ANTHROPIC_API_KEY
# and claimed "free LLM APIs are supported out of the box". Nothing read any of
# them. An env var that looks required and is used by nothing invites someone
# to paste a live credential into a file for no reason.
#
# Now one of them is read, by exactly one package: salvage_brain.language. It
# does three jobs, all of them outside the money path -- proposing taxonomy
# mappings for decline codes the deterministic mapper does not know, writing
# customer nudge copy in Indian languages, and narrating a decision chain for
# an operator. Principle 4 still holds, and it holds structurally rather than
# by convention: tests/test_language_boundary.py reads the import graph and
# fails the build if the diagnosis, policy or taxonomy code can reach the
# language layer at all.
#
# Off by default, and a key on its own does not switch it on. This is the only
# part of Salvage that makes an outbound call to a third party, and cloning the
# repository is not consent to that.
SALVAGE_LANGUAGE_ENABLED=false

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The model id is not asserted to exist by any file in this repository. Run
# `make gemini-e2e` -- it lists the models your key can actually reach, then
# round-trips one completion against the wire format the adapter was written
# for. The value below is a starting point, not a promise about your account.
GEMINI_MODEL=gemini-2.0-flash

# Where accepted triage proposals are appended for human review, one JSON
# object per line. Unset means proposals are returned to the caller and not
# persisted, and the response says so rather than leaving you to assume it was
# filed somewhere. A proposal is never applied: a human edits
# salvage_brain/taxonomy/mapper.py or that table does not change.
TRIAGE_QUEUE_PATH=

# Note on the MCP server, which is the fourth place language belongs: it needs
# nothing here. It exposes read-only tools to whichever assistant connects to
# it, and that assistant brings its own credentials. Salvage never sees them.

# ---- console demo ingest -------------------------------------------------
# The console's checkout page publishes a real payment_failed.v1 event through
# salvage-core. That is a write path, so it is disabled unless switched on.
# Safe on a local stack; leave it false anywhere shared.
SALVAGE_DEMO_INGEST_ENABLED=true

# Public Razorpay key id used by the browser checkout widget. Razorpay key ids
# are public by design (they ship to the client), but this must be YOUR key,
# not one committed to a repository.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Which merchant the console reads. Matches the tenant `make demo` provisions.
NEXT_PUBLIC_DEFAULT_MERCHANT_ID=merch_demo
