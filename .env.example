# Copy to .env and fill in. `.env` is gitignored and must never be committed.
#   cp .env.example .env
#
# Every value below has a working default for local development EXCEPT the two
# marked REQUIRED-FOR, which gate optional paths. The core demo runs with none
# of them set.

# ---- infrastructure (defaults match docker-compose.yml) ------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=salvage
POSTGRES_USER=salvage
POSTGRES_PASSWORD=salvage_local_dev_only

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ---- service ports -------------------------------------------------------
# Ports published on the HOST. The containers always listen on 8080 and 8000
# internally; these only affect what you can reach from your machine. Change
# them if something else already holds the port -- that is why the defaults
# are not 8080 and 8000, which are the two most contended ports there are.
CORE_HOST_PORT=8081
BRAIN_HOST_PORT=8001

# ---- payment provider ----------------------------------------------------
# simulated | razorpay
# `simulated` is the default and requires no credentials. It is deterministic,
# seeded, and runs all test suites, CI, stress tests, and offline simulations.
# `razorpay` issues real test-mode calls against Razorpay Sandbox/Test APIs.
# See docs/adr/0003-payment-provider-abstraction.md.
SALVAGE_PAYMENT_PROVIDER=simulated
SALVAGE_SIMULATED_PROVIDER_SEED=20260829

# OPTIONAL: Razorpay Test Mode Credentials
# For Razorpay Hackathon / Live Test Mode evaluation:
# Obtain keys from: Razorpay Dashboard -> Settings -> API Keys (TEST Mode).
# Test keys must be prefixed with `rzp_test_`. salvage-core refuses to start if this
# value begins with `rzp_live_` (ProviderCredentialsGuard). Note that no
# PaymentProvider adapter exists yet, so setting these does not currently cause any
# call to Razorpay from the backend; see docs/adr/0003.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Settings -> Webhooks. Used for HMAC-SHA256 signature verification.
RAZORPAY_WEBHOOK_SECRET=

# ---- LLM configuration ---------------------------------------------------
# Deliberately empty.
#
# No code in this repository calls an LLM provider. The MCP server exposes
# read-only tools to whichever assistant connects to it (Claude Desktop, for
# instance); that assistant brings its own credentials, and Salvage never sees
# them. Nothing here needs a key.
#
# This block previously declared GEMINI_API_KEY, GROK_API_KEY and
# ANTHROPIC_API_KEY and claimed that "free LLM APIs are supported out of the
# box for explainability and MCP tool Q&A". Nothing read any of them. An env
# var that looks required and is used by nothing invites someone to paste a
# live credential into a file for no reason.
#
# Principle 4 of this project is that no LLM makes a money decision. That holds
# structurally: the MCP tool surface is read-only and neither backend exposes a
# route that would let it execute anything.

# ---- console demo ingest -------------------------------------------------
# The console's checkout page publishes a real payment_failed.v1 event through
# salvage-core. That is a write path, so it is disabled unless switched on.
# Safe on a local stack; leave it false anywhere shared.
SALVAGE_DEMO_INGEST_ENABLED=true

# Public Razorpay key id used by the browser checkout widget. Razorpay key ids
# are public by design (they ship to the client), but this must be YOUR key,
# not one committed to a repository.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Which merchant the console reads. Matches the tenant `make demo` provisions.
NEXT_PUBLIC_DEFAULT_MERCHANT_ID=merch_demo
