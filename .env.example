# Copy to .env and fill in. `.env` is gitignored and must never be committed.
#   cp .env.example .env
#
# Every value below has a working default for local development EXCEPT the two
# marked REQUIRED-FOR, which gate optional paths. The core demo runs with none
# of them set.

# ---- infrastructure (defaults match docker-compose.yml) ------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=salvage
POSTGRES_USER=salvage
POSTGRES_PASSWORD=salvage_local_dev_only

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ---- service ports -------------------------------------------------------
# Ports published on the HOST. The containers always listen on 8080 and 8000
# internally; these only affect what you can reach from your machine. Change
# them if something else already holds the port -- that is why the defaults
# are not 8080 and 8000, which are the two most contended ports there are.
CORE_HOST_PORT=8081
BRAIN_HOST_PORT=8001

# ---- payment provider ----------------------------------------------------
# simulated | razorpay
# `simulated` is the default and requires no credentials. It is deterministic,
# seeded, and runs all test suites, CI, stress tests, and offline simulations.
# `razorpay` issues real test-mode calls against Razorpay Sandbox/Test APIs.
# See docs/adr/0003-payment-provider-abstraction.md.
SALVAGE_PAYMENT_PROVIDER=simulated
SALVAGE_SIMULATED_PROVIDER_SEED=20260829

# OPTIONAL: Razorpay Test Mode Credentials
# For Razorpay Hackathon / Live Test Mode evaluation:
# Obtain keys from: Razorpay Dashboard -> Settings -> API Keys (TEST Mode).
# Test keys must be prefixed with `rzp_test_`. (Live keys `rzp_live_` are strictly rejected by the startup safety guard).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Settings -> Webhooks. Used for HMAC-SHA256 signature verification.
RAZORPAY_WEBHOOK_SECRET=

# OPTIONAL: Anthropic Claude API Key for LLM Explainability & MCP Natural Language Q&A.
# (Note: In accordance with core engineering principles, no LLM makes money decisions; all money movement is strictly algorithmic and deterministic).
ANTHROPIC_API_KEY=
