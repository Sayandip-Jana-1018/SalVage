# ---- secrets -------------------------------------------------------------
# .env holds real credentials (Razorpay test keys, Anthropic key). .env.example
# is committed and holds none. Nothing sensitive ever enters the repository.
.env
.env.local
*.pem
*.key
!ops/**/*.key.example

# ---- java / gradle -------------------------------------------------------
.gradle/
build/
bin/
out/
!gradle/wrapper/gradle-wrapper.jar
*.class

# ---- python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
dist/

# ---- node ----------------------------------------------------------------
node_modules/
.next/
.turbo/
*.tsbuildinfo

# ---- tooling installed by scripts/bootstrap.sh ---------------------------
.toolchain/

# ---- local run artifacts -------------------------------------------------
# Evaluation output is regenerated by `make eval` from a fixed seed; it is
# committed only when it is a released result, never as a side effect of a run.
/tmp/
*.log
.DS_Store
Thumbs.db
